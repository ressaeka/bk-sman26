generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model role {
  id        Int      @id @default(autoincrement())
  nama_role String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @db.DateTime(0)
  user      user[]

  @@map("role")
}

model user {
  id                 Int        @id @default(autoincrement())
  username           String     @unique @db.VarChar(150)
  passwordHash       String     @db.VarChar(255)
  roleId             Int
  siswaId            Int?       @unique
  counselorId        Int?       @unique
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(true)
  createdAt          DateTime   @default(now()) @db.DateTime(0)
  updatedAt          DateTime   @default(now()) @db.DateTime(0)

  role               role       @relation(fields: [roleId], references: [id])
  siswa              siswa?     @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  counselor          counselor? @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  session            session[]

  @@index([roleId])
  @@map("user")
}

model session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime @db.DateTime(0)
  createdAt DateTime @default(now()) @db.DateTime(0)

  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) 
  @@map("session")
}

model counselor {
  id             Int             @id @default(autoincrement())
  nip            String?         @unique @db.VarChar(50)
  nama_counselor String          @db.VarChar(150)
  createdAt      DateTime        @default(now()) @db.DateTime(0)
  updatedAt      DateTime        @default(now()) @db.DateTime(0)

  user           user?
  pelanggaran    Pelanggaran[]
  angketMasalah  AngketMasalah[]
  konseling      Konseling[]
  jadwalAsesmen  JadwalAsesmen[]
  tindakLanjut   TindakLanjutPelanggaran[]

  @@map("counselor")
}

model siswa {
  id                   Int             @id @default(autoincrement())
  nipd                 String?         @db.VarChar(50)
  nisn                 String          @unique @db.VarChar(50)
  nama_siswa           String?         @db.VarChar(150)
  jenis_kelamin        String?         @db.Char(1)
  rombel               String?         @db.VarChar(50)
  tanggal_lahir        DateTime?       @db.Date
  agama                String?         @db.VarChar(50)
  alamat               String?         @db.Text
  totalPoin            Int             @default(0)
  createdAt            DateTime        @default(now()) @db.DateTime(0)
  updatedAt            DateTime        @default(now()) @db.DateTime(0)

  user                 user?
  pelanggaran          Pelanggaran[]
  gayaBelajar          GayaBelajar[]
  angketMasalah        AngketMasalah[]
  minatBakat           MinatBakat[]
  konseling            Konseling[]

  @@index([rombel])    
  @@index([totalPoin]) 
  @@index([nama_siswa])
  @@map("siswa")
}


enum StatusTindakLanjutKasus {
  BELUM_DITANGANI
  DALAM_PEMBINAAN
  SELESAI
  DIBATALKAN
}

enum StatusPelaksanaanTindakan {
  DIRENCANAKAN
  TERLAKSANA
  BATAL_TERTUNDA
}

enum BentukTindakLanjut {
  PEMANGGILAN_SISWA
  PEMANGGILAN_ORANG_TUA
  SURAT_PERNYATAAN
  KONSELING_INDIVIDUAL
  PERTEMUAN_KASUS
  SANKSI_EDUKATIF
  LAINNYA
}

model Pelanggaran {
  id                 Int                     @id @default(autoincrement())
  siswaId            Int
  counselorId        Int?
  jenisPelanggaran   String                  @db.VarChar(255)
  poin               Int
  keterangan         String?                 @db.Text
  statusTindakLanjut StatusTindakLanjutKasus @default(BELUM_DITANGANI)
  createdAt          DateTime                @default(now()) @db.DateTime(0)
  updatedAt          DateTime                @default(now()) @updatedAt @db.DateTime(0)

  siswa              siswa                   @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  counselor          counselor?              @relation(fields: [counselorId], references: [id], onDelete: SetNull)
  tindakLanjut       TindakLanjutPelanggaran[]

  @@index([siswaId])
  @@index([counselorId])
  @@index([statusTindakLanjut])
  @@index([createdAt])
  @@map("pelanggaran")
}

model TindakLanjutPelanggaran {
  id                Int                       @id @default(autoincrement())
  pelanggaranId     Int
  counselorId       Int?
  bentukTindakan    BentukTindakLanjut        @default(PEMANGGILAN_SISWA)
  statusPelaksanaan StatusPelaksanaanTindakan @default(TERLAKSANA)
  tanggalTindakan   DateTime                  @db.Date
  pihakTerlibat     String?                   @db.VarChar(255)
  catatan           String                    @db.Text
  tenggatEvaluasi   DateTime?                 @db.Date
  createdAt         DateTime                  @default(now()) @db.DateTime(0)
  updatedAt         DateTime                  @default(now()) @updatedAt @db.DateTime(0)

  pelanggaran       Pelanggaran               @relation(fields: [pelanggaranId], references: [id], onDelete: Cascade)
  counselor         counselor?                @relation(fields: [counselorId], references: [id], onDelete: SetNull)

  @@index([pelanggaranId])
  @@index([counselorId])
  @@index([statusPelaksanaan])
  @@index([tanggalTindakan])
  @@map("tindak_lanjut_pelanggaran")
}

model GayaBelajar {
  id        Int      @id @default(autoincrement())
  siswaId   Int
  skorV     Int
  skorA     Int
  skorK     Int
  dominan   String   @db.VarChar(50)
  createdAt DateTime @default(now()) @db.DateTime(0)

  siswa     siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@index([siswaId])
  @@map("gaya_belajar")
}

model AngketMasalah {
  id             Int        @id @default(autoincrement())
  siswaId        Int
  counselorId    Int?
  daftarMasalah  String     @db.Text
  ceritaTambahan String?    @db.Text
  statusReview   String     @default("PENDING") @db.VarChar(20)
  catatanGuruBK  String?    @db.Text
  reviewedAt     DateTime?  @db.DateTime(0)
  createdAt      DateTime   @default(now()) @db.DateTime(0)

  siswa          siswa      @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  counselor      counselor? @relation(fields: [counselorId], references: [id], onDelete: SetNull)

  @@index([siswaId])
  @@index([counselorId])
  @@map("angket_masalah")
}

model MinatBakat {
  id          Int      @id @default(autoincrement())
  siswaId     Int
  kodeTop3    String   @db.VarChar(10)
  rekomendasi String   @db.VarChar(150)
  skorR       Int      @default(0)
  skorI       Int      @default(0)
  skorA       Int      @default(0)
  skorS       Int      @default(0)
  skorE       Int      @default(0)
  skorC       Int      @default(0)
  createdAt   DateTime @default(now()) @db.DateTime(0)

  siswa       siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@index([siswaId])
  @@map("minat_bakat")
}

model Konseling {
  id            Int        @id @default(autoincrement())
  siswaId       Int
  counselorId   Int?
  tanggal       DateTime   @db.Date
  jam           String     @db.VarChar(10)
  topik         String     @db.VarChar(150)
  keluhan       String?    @db.Text
  status        String     @default("PENDING") @db.VarChar(20)
  catatanGuruBK String?    @db.Text
  createdAt     DateTime   @default(now()) @db.DateTime(0)
  updatedAt     DateTime   @default(now()) @db.DateTime(0)

  siswa         siswa      @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  counselor     counselor? @relation(fields: [counselorId], references: [id], onDelete: SetNull)

  @@index([siswaId])
  @@index([counselorId])
  @@index([status])     
  @@index([tanggal])    
  @@map("konseling")
}

model JadwalAsesmen {
  id             Int        @id @default(autoincrement())
  counselorId    Int?
  tipe           String     @db.VarChar(50) // ANGKET_MASALAH, GAYA_BELAJAR, MINAT_BAKAT
  judul          String     @db.VarChar(150)
  deskripsi      String?    @db.Text
  tanggalMulai   DateTime   @db.DateTime(0)
  tanggalSelesai DateTime   @db.DateTime(0)
  targetTingkat  String?    @db.VarChar(10) // "ALL", "10", "11", "12", "X", "XI", "XII"
  targetRombel   String?    @db.VarChar(50) // null = semua rombel di tingkat tersebut
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.DateTime(0)
  updatedAt      DateTime   @default(now()) @db.DateTime(0)

  counselor      counselor? @relation(fields: [counselorId], references: [id], onDelete: SetNull)

  @@index([tipe])
  @@index([targetTingkat])
  @@index([targetRombel])
  @@index([tanggalMulai, tanggalSelesai])
  @@index([counselorId])
  @@map("jadwal_asesmen")
}